{
  "name": "100fm-digital",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Hebrew-language radio player for 100FM Digital — live playback, now-playing info, favorites, and DVR timeshift.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmiz1987/100fm-digital.git"
  },
  "homepage": "https://digital.100fm.co.il/app/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "hls.js": "^1.5.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.17.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
